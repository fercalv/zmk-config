// narsil.keymap - Layout para programador con vim
#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define DEF 0
#define SYM 1
#define NAV 2

&mt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
};

&lt {
    tapping-term-ms = <200>;
    flavor = "tap-preferred";
};

/ {
    keymap {
        compatible = "zmk,keymap";

        // Capa 0: QWERTY con home row mods
        default_layer {
            bindings = <
        &kp Q       &kp W       &kp E       &kp R       &kp T        &kp Y       &kp U       &kp I       &kp O       &kp P
        &mt LCTL A  &mt LALT S  &mt LGUI D  &mt LSFT F  &kp G        &kp H       &mt RSFT J  &mt RGUI K  &mt RALT L  &mt RCTL SEMI
        &kp Z       &kp X       &kp C       &kp V       &kp B        &kp N       &kp M       &kp COMMA   &kp DOT     &kp FSLH

                                &kp ESC     &kp LSFT    &lt SYM SPC  &kp RET     &mo NAV     &kp BSPC
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
        };

        // Capa 1: Numeros y simbolos
        sym_layer {
            bindings = <
        &kp N1      &kp N2      &kp N3      &kp N4      &kp N5       &kp N6      &kp N7      &kp N8      &kp N9      &kp N0
        &kp EXCL    &kp AT      &kp HASH    &kp DLLR    &kp PRCNT    &kp CARET   &kp AMPS    &kp STAR    &kp LPAR    &kp RPAR
        &kp GRAVE   &kp TILDE   &kp PIPE    &kp UNDER   &kp PLUS     &kp MINUS   &kp EQUAL   &kp LBKT    &kp RBKT    &kp BSLH

                                &trans      &trans      &trans       &trans      &trans      &trans
            >;
            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN>;
        };

        // Capa 2: Navegacion, F-keys y simbolos de programacion
        nav_layer {
            bindings = <
        &kp F1      &kp F2      &kp F3      &kp F4      &kp F5       &kp F6      &kp F7      &kp F8      &kp F9      &kp F10
        &kp TAB     &kp LBRC    &kp RBRC    &kp LT      &kp GT       &kp LEFT    &kp DOWN    &kp UP      &kp RIGHT   &kp DEL
        &kp F11     &kp F12     &kp SQT     &kp DQT     &kp COLON    &kp HOME    &kp END     &kp PG_DN   &kp PG_UP   &kp INS

                                &trans      &trans      &trans       &trans      &trans      &trans
            >;
            sensor-bindings = <&inc_dec_kp C_BRI_UP C_BRI_DN>;
        };
    };
};
